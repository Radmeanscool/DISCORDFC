# Discord application credentials
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_client_id
# Optional: set this for instant guild-scoped command updates while testing
DISCORD_GUILD_ID=replace_with_test_guild_id
# Comma-separated Discord user IDs allowed to use /admin
ADMIN_USER_IDS=replace_with_admin_user_id
# Default false: users play through /play + Buttons/Select Menus.
# Set true only when registering legacy detail commands for operators/testing.
REGISTER_FALLBACK_COMMANDS=false
# true = register /play when the bot starts (for hosts without a shell, e.g. panel hosting)
REGISTER_COMMANDS_ON_START=false

# Production persistence. Required when NODE_ENV=production.
DATABASE_URL=postgresql://frs:replace_with_database_password@localhost:5432/football_rising_star
# Compose-only database variables; use a secret manager in production
POSTGRES_DB=football_rising_star
POSTGRES_USER=frs
POSTGRES_PASSWORD=replace_with_strong_database_password
# Optional: runtime data path used only when DATABASE_URL is empty (development only)
DATA_FILE=./data/players.json

# Background maintenance and interaction abuse controls
NODE_ENV=development
MAINTENANCE_INTERVAL_MS=900000
# Versus DM outbox drain interval (min 5000 ms)
NOTIFICATION_INTERVAL_MS=60000
# Per-user interactions per window; button panels need several clicks per action (a lineup is ~10)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Local process lock; use a writable shared path per host/container
RUNTIME_LOCK_FILE=./data/discord-bot.lock

# Optional: real-squad overlay built by `pnpm data:import-players` (default path below); set to off to use APK rosters only
# PLAYER_OVERLAY_FILE=./data/external/player-overlay.json
